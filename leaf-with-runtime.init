#!/bin/sh /etc/rc.common
USE_PROCD=1
START=90
STOP=10
BIN=/root/leaf-oray-vmess-ws-upx
CONFIG=${LEAF_CONFIG:-/root/leaf.json}
start_service() {
    [ -x "$BIN" ] || return 1
    [ -r "$CONFIG" ] || return 1
    "$BIN" -c "$CONFIG" -T || return 1
    procd_open_instance
    procd_set_param command "$BIN" -c "$CONFIG"
    procd_set_param respawn 3600 5 5
    procd_set_param file "$CONFIG"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
reload_service() {
    stop
    start
}
